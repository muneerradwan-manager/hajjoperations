<?xml version="1.0" encoding="utf-8"?>
<!--
    Around the mark being counted down to: gold, OUTLINED, never filled.

    That distinction is the card's, and it is load-bearing. Green filled means a
    prayer's time is open now; gold outlined means one is coming. Two marked
    cells, two different marks, and a reader takes both in without reading a
    word. The widget had only the green one, which left the countdown at the top
    pointing at a cell in the strip that looked like every other cell.

    Fill is deliberately absent rather than transparent-at-some-alpha: the card
    gives `next` no background at all, only a 45% edge.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/prayer_widget_gold_edge" />
</shape>
