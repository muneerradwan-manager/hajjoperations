<?xml version="1.0" encoding="utf-8"?>
<!--
    The 44dp disc carrying the coming prayer's own icon: gold, graded 26% → 10%
    down the same 315° diagonal the pane falls along, which is what _Upcoming
    builds it from.

    This is the largest single thing on the card's top half and the widget had
    nothing in its place — which is most of why the two did not look related.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:startColor="@color/prayer_widget_gold_disc_lit"
        android:endColor="@color/prayer_widget_gold_disc_low"
        android:type="linear" />
</shape>
