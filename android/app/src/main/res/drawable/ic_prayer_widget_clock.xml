<?xml version="1.0" encoding="utf-8"?>
<!--
    AppIcons.prayerTimes — the mark at the head of the pane.

    The app's icons are Iconsax, which is a FONT, and a font is exactly the
    thing a widget cannot reach for: the glyphs live in a 670KB Flutter asset
    loaded by an engine that is not running. So the seven the widget needs are
    redrawn here as vectors in the same idiom — 24dp box, 1.5 stroke, round cap
    and join, no fill — and tinted at draw time by the provider.

    They are equivalents, not the same outlines. Held next to the card the
    weight and the silhouette match; traced over it they would not.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,2.75 A9.25,9.25 0 1,0 12,21.25 A9.25,9.25 0 1,0 12,2.75 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12,7.25 L12,12.3 L15.6,14.45"
        android:strokeWidth="1.5"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
