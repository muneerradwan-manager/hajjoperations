<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget's pane. The app draws frosted glass; a launcher cannot blur what
    is behind it, so this is the same shape rendered solid.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/prayer_widget_bg" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/prayer_widget_green_wash" />
</shape>
