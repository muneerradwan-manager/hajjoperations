<?xml version="1.0" encoding="utf-8"?>
<!--
    The location pill, when the position is a real one — GlassBadge in green.

    Its numbers are GlassBadge's: a 26% → 12% gradient left to right, a 32%
    border, and a pill radius. AppRadius.pill is 999; a shape drawable clamps
    the radius to half the height on its own, so any value past that is the same
    pill.

    The place used to be bare green text in the corner. In the app it is a
    bordered pill, and it is the second thing on the card after its title.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/prayer_widget_badge_green_lit"
        android:endColor="@color/prayer_widget_badge_green_low"
        android:type="linear" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="@color/prayer_widget_badge_green_edge" />
</shape>
