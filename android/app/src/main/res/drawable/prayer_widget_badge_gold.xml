<?xml version="1.0" encoding="utf-8"?>
<!--
    The same pill in gold, for a position that was never measured.

    The card turns this chip gold and swaps its pin for a gps mark whenever the
    times are computed for مكة rather than for wherever the phone is standing —
    see _LocationChip. The widget is handed that fact in the payload's
    `approximate` and had been ignoring it, so a widget showing approximate
    times looked exactly like one showing measured times. Gold here is not
    decoration; it is the difference between the two.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/prayer_widget_badge_gold_lit"
        android:endColor="@color/prayer_widget_badge_gold_low"
        android:type="linear" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="@color/prayer_widget_badge_gold_edge" />
</shape>
