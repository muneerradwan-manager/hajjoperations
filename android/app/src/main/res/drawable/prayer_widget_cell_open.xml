<?xml version="1.0" encoding="utf-8"?>
<!--
    Behind the prayer whose time is open. Only ever applied to one cell, and
    never to الشروق — see PrayerWidgetProvider, and the same rule in the card.

    Fill and edge are the card's own alphas for a `current` cell: tone at 14%
    behind, tone at 34% around. The edge is what was missing — the card rings
    this cell as well as filling it, and a fill with no edge reads as a smudge
    rather than a marked cell.

    Radius is AppRadius.xs, the card's cell radius. It was 8dp.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/prayer_widget_green_wash" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/prayer_widget_green_edge" />
</shape>
