<?xml version="1.0" encoding="utf-8"?>
<!--
    The same widget on a dark home screen. See values/colors.xml for what each
    name is in the Flutter palette; this file is the `onDark` half of every
    pair, and the dark half of every GlassTokens value:

        pane_start   GlassTokens.dark.fill over AppColors.nightMid, LIT
        pane_end     the same, unlit — the inversion values/colors.xml explains
        stroke       GlassTokens.dark.stroke
        well         GlassTokens.dark.fillSubtle
        ink          AppColors.inkInverse
        muted        AppColors.hint
        green        AppColors.lightGreen          (scheme.primary)
        gold         AppColors.darkGold            (Accent.gold.onDark)
        divider      scheme.outlineVariant at 40%

    The stroke is white here and black on paper, and neither is the brand green.
    That is deliberate, and it is the rule GlassTokens sets at length: an edge
    with a hue of its own argues with whatever the pane is washed in — and this
    pane is washed green the moment a prayer opens.
-->
<resources>
    <!-- ── The pane ──────────────────────────────────────────────────────── -->
    <color name="prayer_widget_pane_start">#223633</color>
    <color name="prayer_widget_pane_end">#142926</color>
    <color name="prayer_widget_stroke">#1FFFFFFF</color>
    <color name="prayer_widget_divider">#66061816</color>
    <!-- On night a well is LIGHTER than the pane — the paper file's is darker. -->
    <color name="prayer_widget_well">#0DFFFFFF</color>

    <!-- ── Ink ───────────────────────────────────────────────────────────── -->
    <color name="prayer_widget_ink">#F6F3F0</color>
    <color name="prayer_widget_muted">#8A8A8A</color>

    <!-- ── The two tones that carry meaning ──────────────────────────────── -->
    <color name="prayer_widget_green">#289E92</color>
    <color name="prayer_widget_gold">#AD9E6E</color>

    <color name="prayer_widget_green_wash">#24289E92</color>
    <color name="prayer_widget_green_edge">#57289E92</color>
    <color name="prayer_widget_green_disc">#24289E92</color>
    <color name="prayer_widget_gold_edge">#73AD9E6E</color>
    <color name="prayer_widget_gold_disc_lit">#42AD9E6E</color>
    <color name="prayer_widget_gold_disc_low">#1AAD9E6E</color>

    <color name="prayer_widget_badge_green_lit">#42289E92</color>
    <color name="prayer_widget_badge_green_low">#1F289E92</color>
    <color name="prayer_widget_badge_green_edge">#52289E92</color>
    <color name="prayer_widget_badge_gold_lit">#42AD9E6E</color>
    <color name="prayer_widget_badge_gold_low">#1FAD9E6E</color>
    <color name="prayer_widget_badge_gold_edge">#52AD9E6E</color>
</resources>
