<?xml version="1.0" encoding="utf-8"?>
<!--
    مواقيت الصلاة on the home screen, laid out right to left.

    This is PrayerTimesCard with the moving parts taken out, and it is meant to
    be read beside that file — the order down the pane is the card's own
    (header, gap, what is coming, the note, the rule, the six marks), and every
    size and colour here has a line there it came from.

    There is a second copy of this file, prayer_widget.xml, identical but
    for android:layoutDirection on the root and on the strip. That duplication
    is deliberate. A widget is drawn by the LAUNCHER's process, in the LAUNCHER's
    locale, and this app's language is its own choice — somebody running it in
    Arabic on an English phone must not get the strip built backwards. The
    direction is not something RemoteViews can set at runtime
    (View.setLayoutDirection is not a remotable method), so it is baked into two
    layouts and the provider picks one. Any change here belongs in both.

    Two things RemoteViews will not allow, which explain what look like odd
    choices below:

      * <View> is not a permitted type, so the rule under the countdown is a
        1dp FrameLayout. <Space> is not permitted either, which is why every
        gap is a layout_marginTop rather than a spacer.
      * There is no progress bar. The card has one — _ProgressBar, under the
        countdown — and it is driven by a one-second ticker. Nothing here ticks:
        the pane is redrawn six times a day, at the boundaries, so a bar would
        be painted at the instant a window OPENS and would therefore read empty
        every time anybody looked at it. A bar that is always at zero is not a
        quiet bar, it is a wrong one. The Chronometer carries the same fact
        honestly, because the launcher counts it down itself.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="@drawable/prayer_widget_bg"
    android:padding="12dp">

    <!-- ── The head: what this is, and where it is for ────────────────────
         _Header. A 34dp disc of primary at 14%, the title in titleSmall at
         w700, and the location pill pushed to the far end. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/prayer_widget_head_disc">

            <ImageView
                android:id="@+id/prayer_widget_head_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_prayer_widget_clock"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/prayer_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/itf_qomra"
            android:textColor="@color/prayer_widget_ink" />

        <!-- GlassBadge, dense: 8dp by 3dp inside a pill, an 11dp mark, and the
             label at 10.5sp w700. The provider swaps both this background and
             the mark for their gold pair when the position is only approximate. -->
        <LinearLayout
            android:id="@+id/prayer_widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/prayer_widget_badge_green">

            <ImageView
                android:id="@+id/prayer_widget_badge_icon"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_prayer_widget_location"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/prayer_widget_place"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:fontFamily="@font/itf_qomra"
                android:textColor="@color/prayer_widget_green" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── What is coming, and how long is left ───────────────────────────
         _Upcoming. The 44dp gold disc carries the coming prayer's own icon;
         the countdown is the only thing on this pane that moves. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/prayer_widget_next_disc"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/prayer_widget_next_disc">

            <ImageView
                android:id="@+id/prayer_widget_next_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_prayer_widget_noon"
                android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/prayer_widget_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="11sp"
                android:fontFamily="@font/itf_qomra"
                android:textColor="@color/prayer_widget_muted" />

            <TextView
                android:id="@+id/prayer_widget_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/itf_qomra"
                android:textColor="@color/prayer_widget_ink" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Pinned LTR for the reason the card gives: a run of digits
                 separated by colons is one bidi number and would come out in
                 the right order anyway, but this is the one string on the pane
                 that changes every second and it is not worth depending on the
                 algorithm to keep it from flipping. -->
            <Chronometer
                android:id="@+id/prayer_widget_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/itf_qomra"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/prayer_widget_gold" />

            <TextView
                android:id="@+id/prayer_widget_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="11sp"
                android:fontFamily="@font/itf_qomra"
                android:textColor="@color/prayer_widget_muted" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── The note ───────────────────────────────────────────────────────
         Only ever visible when there is something to admit: no prayer is due,
         or the times on this widget have run out. A well sunk into the pane,
         the way the card's _gapNote is. -->
    <LinearLayout
        android:id="@+id/prayer_widget_notice_well"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/prayer_widget_well"
        android:visibility="gone">

        <ImageView
            android:id="@+id/prayer_widget_notice_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_prayer_widget_sunrise"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/prayer_widget_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:fontFamily="@font/itf_qomra"
            android:textColor="@color/prayer_widget_muted" />
    </LinearLayout>

    <!-- The rule between the two halves. A FrameLayout because RemoteViews will
         not inflate a bare <View>. -->
    <FrameLayout
        android:id="@+id/prayer_widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/prayer_widget_divider" />

    <!-- The six marks of the day. Filled by the provider, one child per mark. -->
    <LinearLayout
        android:id="@+id/prayer_widget_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layoutDirection="rtl"
        android:orientation="horizontal" />
</LinearLayout>
