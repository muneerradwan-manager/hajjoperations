<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget's palette, on a light home screen.

    These are the app's own brand values copied out of lib/core/theme —
    AppColors, GlassTokens and the Accent pairs — because the widget is drawn by
    Android and cannot read a Dart file. The names below are the Flutter names,
    so that the two can be compared line by line when the palette changes.

    The pane is the CARD's colour, not the desk's. It was paperTop until the
    widget was held up against PrayerTimesCard: the app's card is white at 80%
    over that field, so painting the widget the field itself made it the one
    surface in the whole system drawn the colour of the BACKGROUND rather than
    the colour of a card. What it is now is that blend, resolved — a launcher
    cannot composite against a backdrop it does not have.

        pane_start   GlassTokens.light.fill over AppColors.paperTop
        pane_end     the same, shaded by GlassTokens.light.sheen (see below)
        stroke       GlassTokens.light.stroke
        well         GlassTokens.light.fillSubtle
        ink          AppColors.ink                 (scheme.onSurface)
        muted        AppColors.hintStrong          (scheme.onSurfaceVariant)
        green        AppColors.darkGreen           (scheme.primary)
        gold         Accent.gold.onLight
        divider      scheme.outlineVariant at 40%

    Which end is lit is NOT the same in the two modes, and the gradient's angle
    is fixed in the drawable — so the inversion lives here, in which colour is
    `start`. See GlassTokens.fillGradient: on paper the near corner is already
    white and has nowhere brighter to go, so it is the FAR corner that is shaded
    (start bright, end shaded); on night the near corner is lit instead (start
    lit, end base). Read the night file beside this one and the two `start`
    values look inconsistent. They are the same rule, spent from both ends.
-->
<resources>
    <!-- ── The pane ──────────────────────────────────────────────────────── -->
    <color name="prayer_widget_pane_start">#FDFCFB</color>
    <color name="prayer_widget_pane_end">#F8F7F6</color>
    <color name="prayer_widget_stroke">#25000000</color>
    <color name="prayer_widget_divider">#66D6D6D6</color>
    <!-- A well sunk INTO the pane, which on paper is darker than the pane. -->
    <color name="prayer_widget_well">#0D000000</color>

    <!-- ── Ink ───────────────────────────────────────────────────────────── -->
    <color name="prayer_widget_ink">#001614</color>
    <color name="prayer_widget_muted">#5E5E5E</color>

    <!-- ── The two tones that carry meaning ──────────────────────────────── -->
    <!-- green: a prayer's time is OPEN. gold: the mark being counted down to. -->
    <color name="prayer_widget_green">#00594F</color>
    <color name="prayer_widget_gold">#6D6445</color>

    <!-- Washes and edges, at the alphas PrayerTimesCard uses for each. -->
    <color name="prayer_widget_green_wash">#2400594F</color>
    <color name="prayer_widget_green_edge">#5700594F</color>
    <color name="prayer_widget_green_disc">#2400594F</color>
    <color name="prayer_widget_gold_edge">#736D6445</color>
    <color name="prayer_widget_gold_disc_lit">#426D6445</color>
    <color name="prayer_widget_gold_disc_low">#1A6D6445</color>

    <!-- The location pill — GlassBadge's gradient, border and both tones. -->
    <color name="prayer_widget_badge_green_lit">#4200594F</color>
    <color name="prayer_widget_badge_green_low">#1F00594F</color>
    <color name="prayer_widget_badge_green_edge">#5200594F</color>
    <color name="prayer_widget_badge_gold_lit">#426D6445</color>
    <color name="prayer_widget_badge_gold_low">#1F6D6445</color>
    <color name="prayer_widget_badge_gold_edge">#526D6445</color>
</resources>
