# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.env

# Secrets / service-account keys — never commit
firebase/*-adminsdk-*.json
**/*serviceAccount*.json
# Admin/service keys for local seeding. Deliberately NOT `.env`: that file is
# bundled as a Flutter asset, so anything in it ships inside the APK.
.env.seed
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. The keystore lives outside the repo (…/Projects/keys) and the
# passwords must never enter it: lose the key and the app can never be updated,
# leak it and anyone can publish as you.
android/key.properties
**/*.jks
**/*.keystore
